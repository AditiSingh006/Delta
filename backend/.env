# Port the backend server listens on
PORT=4000

# Any long random string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# "mock" = simulated realistic price data, no API key needed, works instantly
# "twelvedata" = real live NSE/BSE prices via twelvedata.com free API
DATA_MODE=mock

# Only needed if DATA_MODE=twelvedata
TWELVEDATA_API_KEY=cc2ae9360c114dfeb8b54592f216acde

# How often (in seconds) the server polls/refreshes prices for all watchlisted symbols
POLL_INTERVAL_SECONDS=60

# Must match where the frontend runs, so the browser is allowed to call this API
CORS_ORIGIN=http://localhost:5173
